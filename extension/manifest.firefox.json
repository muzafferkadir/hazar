{
  "manifest_version": 3,
  "name": "Hazar Download Manager",
  "description": "Hands downloads to the Hazar download manager: files, HLS and DASH streams.",
  "version": "0.2.5",
  "author": "Muzaffer Kadir Yılmaz",
  "action": {
    "default_title": "Hazar Download Manager",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "background": {
    "scripts": [
      "src/lib.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js",
        "recapture.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "permissions": [
    "downloads",
    "cookies",
    "tabs",
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "alarms",
    "proxy"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  }
}
